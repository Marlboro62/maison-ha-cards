[
 {
  "name": "chips",
  "width": 820,
  "cards": [
   {
    "type": "custom:maison-chips-card",
    "chips": [
     {
      "type": "tempo",
      "entity": "sensor.rte_tempo_couleur_actuelle",
      "next": "sensor.rte_tempo_prochaine_couleur",
      "tap_action": {
       "action": "navigate",
       "navigation_path": "#tempo"
      }
     },
     {
      "type": "gate",
      "entity": "cover.portail2"
     },
     {
      "entity": "binary_sensor.verrousoussol_contact",
      "icon": "mdi:garage-open-variant",
      "name": "ouvert",
      "active": true,
      "show": {
       "state": "on"
      }
     },
     {
      "type": "count",
      "entity": "sensor.count_nombre_ouvrants_ouverts",
      "icon": "mdi:window-open-variant"
     },
     {
      "type": "goal",
      "entity": "sensor.rex_activity_time",
      "goal": "sensor.rex_daily_goal",
      "name": "Rex {state|int}min"
     },
     {
      "type": "battery",
      "entity": "sensor.mokka_battery_level",
      "label": "mokka",
      "charging": {
       "entity": "sensor.mokka_charging_status",
       "state": "InProgress"
      }
     },
     {
      "type": "battery",
      "entity": "sensor.battery",
      "label": "Tesla",
      "charging": {
       "entity": "binary_sensor.charging",
       "state": "on"
      },
      "plugged": {
       "entity": "binary_sensor.charger",
       "state": "on"
      }
     },
     {
      "entity": "sensor.jardin_switch_borne_electric_consumption_w",
      "icon": "mdi:ev-station",
      "name": "{state|int}W",
      "active": true,
      "show": {
       "above": 300
      }
     },
     {
      "entity": "sensor.jours_granules_restants",
      "icon": "mdi:calendar-end",
      "name": "{state|int}j",
      "show": {
       "entity": "input_select.mode_saison",
       "state": "hiver"
      },
      "levels": [
       {
        "above": 30,
        "color": "green"
       },
       {
        "above": 15,
        "color": "orange"
       },
       {
        "color": "red"
       }
      ]
     },
     {
      "entity": "input_number.granule_restant",
      "icon": "mdi:silo",
      "name": "{state|int}kg",
      "show": {
       "entity": "input_select.mode_saison",
       "state": "hiver"
      },
      "levels": [
       {
        "above": 1500,
        "color": "green"
       },
       {
        "above": 500,
        "color": "orange"
       },
       {
        "color": "red"
       }
      ]
     },
     {
      "entity": "sensor.douches_douche1",
      "icon": "mdi:shower-head",
      "name": "{state|int}L",
      "show": {
       "above": 0
      },
      "levels": [
       {
        "below": 31,
        "color": "green"
       },
       {
        "below": 60,
        "color": "orange"
       },
       {
        "color": "red"
       }
      ]
     },
     {
      "entity": "sensor.douches_douche3",
      "icon": "mdi:shower-head",
      "name": "{state|int}L",
      "show": {
       "above": 0
      },
      "levels": [
       {
        "below": 31,
        "color": "green"
       },
       {
        "below": 60,
        "color": "orange"
       },
       {
        "color": "red"
       }
      ]
     },
     {
      "type": "printer",
      "tap_action": {
       "action": "navigate",
       "navigation_path": "#bambu"
      }
     },
     {
      "type": "timer",
      "entity": "sensor.lave_linge_remaining_time",
      "icon": "mdi:washing-machine"
     },
     {
      "entity": "input_select.cuisine_lavevaisselle",
      "icon": "mdi:dishwasher",
      "active": true,
      "show": {
       "state_not": "off"
      },
      "name": "{sensor.temps_restant_lavevaisselle}",
      "states": {
       "fini": {
        "name": "fini"
       }
      }
     },
     {
      "type": "vacuum",
      "entity": "vacuum.alfred",
      "name": "{sensor.cuisine_alfred_cleaning_area|int} m²"
     },
     {
      "type": "flag",
      "entity": "input_boolean.vider_bac_poussiere",
      "icon": "mdi:robot-vacuum",
      "name": "plein",
      "tap_action": "toggle"
     },
     {
      "entity": "switch.deshumidificateur",
      "icon": "mdi:air-humidifier",
      "name": "{sensor.cagibi_temperature_humidity|int}%",
      "active": true,
      "show": {
       "state": "on"
      },
      "tap_action": "toggle"
     },
     {
      "type": "bin",
      "entity": "binary_sensor.lundi",
      "name": "Poubelle Marron",
      "color": "brown",
      "after": "00:00"
     },
     {
      "entity": "counter.compteur_sodastream",
      "icon": "mdi:bottle-soda",
      "name": "x{state}",
      "active": true,
      "tap_action": {
       "action": "perform-action",
       "perform_action": "counter.reset",
       "target": {
        "entity_id": "counter.compteur_sodastream"
       }
      }
     },
     {
      "entity": "sensor.eta_alex",
      "icon": "mdi:car-clock",
      "name": "ETA Alex : {state} min",
      "color": "pop",
      "show": [
       {
        "entity": "input_boolean.alex_revient",
        "state": "on"
       },
       {
        "entity": "person.alex",
        "state_not": "home"
       }
      ]
     }
    ]
   }
  ]
 },
